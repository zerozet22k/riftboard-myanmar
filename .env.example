MONGODB_URI=""
# Optional comma-separated DNS resolvers for environments with a broken local SRV resolver.
MONGODB_DNS_SERVERS=""
# Optional database name when MONGODB_URI does not include one.
MONGODB_DB=""

RIOT_API_KEY=""
# Optional. If omitted, TFT endpoints use RIOT_API_KEY. TFT_API_KEY is a legacy alias.
RIOT_TFT_API_KEY=""
RIOT_ACCOUNT_REGION="asia"
# Optional match-routing override: americas, asia, europe, or sea.
RIOT_MATCH_REGION=""

SUBMIT_CODE=""
CRON_KEY=""
SCHEDULER_TOKEN=""
CRON_SECRET=""
# Background profile refresh defaults. Set sync to "false" to stop match-history caching.
LEADERBOARD_CRON_LIMIT="5"
LEADERBOARD_CRON_MAX_LIMIT="10"
LEADERBOARD_CRON_DELAY_MS="1500"
LEADERBOARD_CRON_SYNC_MATCHES="true"
LEADERBOARD_CRON_MATCHES_COUNT="5"
LEADERBOARD_CRON_MATCH_BACKFILL_COUNT="0"
LEADERBOARD_CRON_SYNC_TFT_MATCHES="false"
TFT_MATCH_CRON_LIMIT="5"
TFT_MATCH_CRON_MAX_LIMIT="10"
TFT_MATCH_CRON_DELAY_MS="1500"
TFT_MATCH_CRON_MATCHES_COUNT="5"
# Matches retained per player by npm run cleanup:matches (clamped to 1..200).
MATCH_RETENTION_LIMIT="50"
# Conservative defaults for personal Riot keys (100 requests per two minutes).
RIOT_MIN_REQUEST_INTERVAL_MS="1250"
RIOT_RATE_LIMIT_SAFETY_FACTOR="1.08"
RIOT_429_FALLBACK_MS="120000"
RIOT_MAX_RETRY_WAIT_MS="15000"
RIOT_REQUEST_TIMEOUT_MS="15000"
# Optional token for shared cron-only tray runners. Rotate this if it leaks.
COMMUNITY_RUNNER_TOKEN=""
REFRESH_RUNNER_TOKEN=""

# Reserved for local wrappers/manual tooling; the web app uses APP_BASE_URL.
LOCAL_APP_URL="http://127.0.0.1:3000"
# PUBLIC_APP_URL is a tray-only alias. APP_BASE_URL is the canonical server URL.
APP_BASE_URL="http://127.0.0.1:3000"
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"
NEXT_PUBLIC_ENABLE_BULK_SUBMIT="0"

# Optional Google Search Console verification token.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION is a supported public fallback alias.
GOOGLE_SITE_VERIFICATION=""
# Optional Google AdSense monetization. Leave both blank until the site is approved.
# Client IDs look like ca-pub-1234567890123456; slot IDs contain digits only.
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_ADSENSE_LEADERBOARD_SLOT_ID=""
NEXT_PUBLIC_GOOGLE_ADSENSE_TFT_SLOT_ID=""

COMMUNITY_JOIN_CODE=""
TOURNAMENT_HOST_CODE=""
# Tournament API stays disabled unless explicitly enabled.
RIOT_TOURNAMENT_API_ENABLED="false"
RIOT_TOURNAMENT_CALLBACK_TOKEN=""
# Several legacy Discord invite variable names are supported as fallbacks.
COMMUNITY_DISCORD_URL=""
APP_SESSION_SECRET=""

# DISCORD_CLIENT_ID is a supported alias for DISCORD_APPLICATION_ID.
DISCORD_APPLICATION_ID=""
DISCORD_PUBLIC_KEY=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN=""
# DISCORD_SERVER_GUILD_ID is a supported alias for DISCORD_GUILD_ID.
DISCORD_GUILD_ID=""
DISCORD_LIVE_GAMES_CHANNEL_ID="1504353915091681360"
DISCORD_REGISTER_GLOBAL_COMMANDS=""
DISCORD_REDIRECT_URI="http://127.0.0.1:3000/api/discord/oauth/callback"
DISCORD_SYNC_SERVER_ROLES_ROLE_ID="1490362401038663910"
DISCORD_RANK_ROLE_PREFIX="Rank"
DISCORD_BIND_ROLE_NAME="Riftboard: Bind Riot"
DISCORD_BIND_ROLE_COLOR="5865F2"
DISCORD_VERIFIED_ROLE_NAME="Riftboarded"
DISCORD_VERIFIED_ROLE_COLOR="2ECC71"
# Optional custom emoji codes for Discord live-game rank badges.
# Use Discord's full emoji form, for example <:Diamond:123456789012345678>.
# DISCORD_EMOJI_MAP is a supported comma-separated fallback for these individual keys.
DISCORD_EMOJI_CHALLENGER=""
DISCORD_EMOJI_GRANDMASTER=""
DISCORD_EMOJI_MASTER=""
DISCORD_EMOJI_DIAMOND=""
DISCORD_EMOJI_EMERALD=""
DISCORD_EMOJI_PLATINUM=""
DISCORD_EMOJI_GOLD=""
DISCORD_EMOJI_SILVER=""
DISCORD_EMOJI_BRONZE=""
DISCORD_EMOJI_IRON=""
DISCORD_EMOJI_TOP=""
DISCORD_EMOJI_JUNGLE=""
DISCORD_EMOJI_MID=""
DISCORD_EMOJI_BOT=""
DISCORD_EMOJI_SUPPORT=""

# RIOT_RSO_CLIENT_ID and RIOT_RSO_CLIENT_SECRET are supported fallback aliases.
RSO_CLIENT_ID=""
RSO_CLIENT_SECRET=""
RSO_REDIRECT_URI="http://127.0.0.1:3000/api/riot/oauth/callback"

ADMIN_SECRET=""
